# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret for Admin Authentication (change this in production!)
JWT_SECRET=super_secret_jwt_key_here_change_in_production_min_32_chars

# Allowed Client Origin(s) for CORS and Socket.IO (comma-separated or * in dev)
# For subdomain deployment, add your subdomain: e.g. https://quiz.yourdomain.com
CLIENT_URL=http://localhost:5173,http://localhost:3000

# Firebase Realtime Database Configuration
# Find this in Firebase Console -> Project Settings -> Realtime Database URL
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com/

# Option 1: File path to downloaded serviceAccountKey.json file
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option 2: Raw JSON string of serviceAccountKey.json (useful for cloud/container deploy without file)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
