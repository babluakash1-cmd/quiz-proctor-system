# Frontend Environment Variables
# If deploying frontend and backend together under the same subdomain (recommended):
# leave VITE_API_URL blank or comment it out.
#
# If backend is deployed to a different subdomain or port (e.g., https://api-quiz.yourdomain.com):
# VITE_API_URL=https://api-quiz.yourdomain.com
#
# In local development:
VITE_API_URL=http://localhost:5000
